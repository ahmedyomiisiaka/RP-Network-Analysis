# ==========================================================
# RP Network Analysis - .gitignore
# MSc Thesis | Vilnius University
# ==========================================================

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*$py.class

# -----------------------------
# Jupyter / Google Colab
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# Virtual environments
# -----------------------------
venv/
.env/
.envrc

# -----------------------------
# macOS / Windows
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# Large datasets
# -----------------------------
data/raw/
data/processed/*
!data/processed/context_specific_evidence_master.tsv
data/results/

# -----------------------------
# Large network files
# -----------------------------
*.graphml
*.gml
*.sif
*.xml
*.xgmml

# -----------------------------
# Compressed files
# -----------------------------
*.zip
*.tar
*.gz
*.7z
*.rar

# -----------------------------
# Figures generated during analysis
# -----------------------------
figures/output/

# -----------------------------
# Temporary files
# -----------------------------
*.log
*.tmp
*.bak

# -----------------------------
# IDE settings
# -----------------------------
.vscode/
.idea/

# Large external database downloads
data/raw/*.gz
data/raw/*.zip
data/raw/*.tsv
data/raw/*.txt
data/raw/*.xlsx

# Colab/Python temporary files
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db
