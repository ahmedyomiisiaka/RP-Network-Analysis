# ==========================================================
# RP Network Analysis - .gitignore
# MSc Thesis | Vilnius University
# ==========================================================

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*$py.class

# -----------------------------
# Jupyter / Google Colab
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# Virtual environments
# -----------------------------
venv/
.env/
.envrc

# -----------------------------
# macOS / Windows
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# Large datasets
# -----------------------------
data/raw/

# Processed data are ignored by default.
data/processed/*

# Keep the final Stage-5 analysis directory.
!data/processed/stage5_context_filtering/
!data/processed/stage5_context_filtering/**

# Keep Stage-6 documentation/results directory.
!data/processed/stage6_pathway_reconstruction/
!data/processed/stage6_pathway_reconstruction/**

data/results/

# -----------------------------
# Large network files
# -----------------------------
*.graphml
*.gml
*.sif
*.xml
*.xgmml

# -----------------------------
# Compressed files
# -----------------------------
*.zip
*.tar
*.gz
*.7z
*.rar

# -----------------------------
# Figures generated during analysis
# -----------------------------
figures/output/

# -----------------------------
# Temporary files
# -----------------------------
*.log
*.tmp
*.bak

# -----------------------------
# IDE settings
# -----------------------------
.vscode/
.idea/

# Large external database downloads
data/raw/*.gz
data/raw/*.zip
data/raw/*.tsv
data/raw/*.txt
data/raw/*.xlsx

# Colab/Python temporary files
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Keep the completed 4,132-protein pathway enrichment analysis.
!data/processed/pathway_enrichment_4132/
!data/processed/pathway_enrichment_4132/**
